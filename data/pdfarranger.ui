<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkApplicationWindow" id="main_window">
    <child type="titlebar">
      <object class="GtkHeaderBar" id="header_bar">
        <child type="start">
          <object class="GtkBox">
            <property name="homogeneous">1</property>
            <style>
              <class name="linked"/>
            </style>
            <child>
              <object class="GtkButton">
                <property name="focus_on_click">0</property>
                <property name="tooltip_text" translatable="1">Open</property>
                <property name="action_name">win.open</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">document-open-symbolic</property>
                    <property name="use_fallback">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="focus_on_click">0</property>
                <property name="tooltip_text" translatable="1">Import</property>
                <property name="action_name">win.import</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">insert-image-symbolic</property>
                    <property name="use_fallback">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="tooltip_text" translatable="1">Save</property>
                <property name="action_name">win.save</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">document-save-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="save_as_bar_button">
                <property name="tooltip_text" translatable="1">Save As</property>
                <property name="action_name">win.save-as</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">document-save-as-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child type="end">
          <object class="GtkMenuButton" id="main_menu_button">
            <property name="tooltip_text" translatable="1">Main Menu</property>
            <child>
              <object class="GtkImage">
                <property name="icon_name">open-menu-symbolic</property>
              </object>
            </child>
          </object>
        </child>
        <child type="end">
          <object class="GtkBox">
            <property name="homogeneous">1</property>
            <style>
              <class name="linked"/>
            </style>
            <child>
              <object class="GtkButton">
                <property name="focus_on_click">0</property>
                <property name="tooltip_text" translatable="1">Zoom In</property>
                <property name="action_name">win.zoom-in</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">zoom-in-symbolic</property>
                  </object>
                </child>
                <style>
                  <class name="image-button"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="focus_on_click">0</property>
                <property name="tooltip_text" translatable="1">Zoom Out</property>
                <property name="action_name">win.zoom-out</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">zoom-out-symbolic</property>
                  </object>
                </child>
                <style>
                  <class name="image-button"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child type="end">
          <object class="GtkBox">
            <property name="homogeneous">1</property>
            <style>
              <class name="linked"/>
            </style>
            <child>
              <object class="GtkButton">
                <property name="focus_on_click">0</property>
                <property name="tooltip_text" translatable="1">Rotate Left</property>
                <property name="action_name">win.rotate</property>
                <property name="action_target">-90</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">object-rotate-left-symbolic</property>
                  </object>
                </child>
                <style>
                  <class name="image-button"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="focus_on_click">0</property>
                <property name="tooltip_text" translatable="1">Rotate Right</property>
                <property name="action_name">win.rotate</property>
                <property name="action_target">90</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">object-rotate-right-symbolic</property>
                  </object>
                </child>
                <style>
                  <class name="image-button"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="main_box">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkScrolledWindow" id="scrolledwindow">
            <property name="vexpand">1</property>
            <child>
              <placeholder/>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator"/>
        </child>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkStatusbar" id="statusbar">
                <property name="hexpand">1</property>
              </object>
            </child>
            <child>
              <object class="GtkStatusbar" id="statusbar2"/>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="AdwAlertDialog" id="content-loss-warning">
    <property name="heading" translatable="yes">Note</property>
    <property name="body-use-markup">1</property>
    <property name="body" translatable="yes">Note the limitations:

Cropping/hiding does not remove any content from the PDF file, it only hides it.

Outlines and links can be preserved only in certain cases. For more info see &lt;a href=&quot;https://github.com/pdfarranger/pdfarranger/wiki/User-Manual#preserving-of-outlines-and-links&quot;&gt;User Manual&lt;/a&gt;</property>
    <responses>
      <response id="ok" translatable="yes">_OK</response>
    </responses>
    <property name="extra-child">
      <object class="GtkCheckButton" id="do-not-show-again">
        <property name="label" translatable="yes">_Do not show this dialog again.</property>
        <property name="use-underline">1</property>
      </object>
    </property>
  </object>
  <object class="AdwPreferencesDialog" id="preferences">
    <property name="title" translatable="yes">Preferences</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="AdwHeaderBar"/>
        </child>
        <child>
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">General</property>
                <child>
                  <object class="AdwComboRow" id="languages">
                    <property name="title" translatable="yes">Language</property>
                    <property name="subtitle" translatable="yes">Requires restart</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">System setting</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="theme">
                    <property name="title" translatable="yes">Theme</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">System setting</item>
                          <item translatable="yes">Light</item>
                          <item translatable="yes">Dark</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Printing</property>
                <child>
                  <object class="AdwComboRow" id="scale-mode">
                    <property name="title" translatable="yes">Scale mode</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">None</item>
                          <item translatable="yes">Fit to printable area</item>
                          <item translatable="yes">Fit to full page</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="auto-rotate">
                    <property name="title" translatable="yes">Auto rotate</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkFrame">
            <style>
              <class name="no-border"/>
            </style>
            <property name="label" translatable="yes">For more options see:</property>
            <child>
              <object class="GtkLabel">
                <property name="selectable">yes</property>
                <property name="label">/home/linkmauve/config/pdfarranger/config.ini</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
